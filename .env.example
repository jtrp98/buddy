# PostgreSQL (Neon)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Secrets (generate 32-byte hex values: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET=""
ASSIGNMENT_ENCRYPTION_KEY=""
# Optional (only needed if triggering /api/cron/process-draws manually)
CRON_SECRET=""

# Public base URL (e.g., https://your-app.vercel.app)
APP_URL="http://localhost:3000"

# Free Email via Gmail SMTP (using Google App Password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Secret Buddy <your-gmail@gmail.com>"

# Optional Resend API (if you own a verified domain)
RESEND_API_KEY=""
