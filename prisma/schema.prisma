generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BudgetType {
  FIXED
  RANGE
  MIN
  UNLIMITED
}

enum GroupStatus {
  DRAFT
  OPEN
  DRAWING
  ACTIVE
  COMPLETED
}

enum EmailType {
  VERIFY_EMAIL
  MANAGE_LINK
  RESULT_NOTIFICATION
  LINK_RECOVERY
  CHAT_NOTIFICATION
}

enum SecretChatMode {
  PUBLIC_ROOM
  PRIVATE_DM
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

model Admin {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  isSuperAdmin Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  groups Group[]
}

model Group {
  id                   String      @id @default(cuid())
  adminId              String
  title                String
  description          String?
  inviteCode           String      @unique
  budgetType           BudgetType  @default(FIXED)
  budgetMin            Int?
  budgetMax            Int?
  registrationClosesAt DateTime
  revealAt             DateTime?
  status               GroupStatus @default(DRAFT)
  guessOpen            Boolean     @default(false)
  drawError            String?
  drawnAt              DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  admin         Admin            @relation(fields: [adminId], references: [id], onDelete: Cascade)
  members       Member[]
  assignments   Assignment[]
  emailLogs     EmailLog[]
  exclusions    GroupExclusion[]
  secretThreads SecretThread[]
  buddyGuesses  BuddyGuess[]

  @@index([adminId])
  @@index([status, registrationClosesAt])
}

model Member {
  id                   String    @id @default(cuid())
  groupId              String
  displayName          String
  email                String
  emailVerifiedAt      DateTime?
  verifyTokenHash      String?   @unique
  verifyTokenExpiresAt DateTime?
  manageTokenHash      String?   @unique
  resultTokenHash      String?   @unique

  // Buddy Profile
  interests         String[] @default([])
  interestOther     String?
  favoriteColor     String?
  favoriteFoodDrink String?
  hobbies           String?
  giftStyle         String?
  dislikes          String?
  allergies         String?
  wishList          String?
  wishListLinks     Json?
  noteToBuddy       String?
  lastChatNotifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group                 Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  givenAssignment       Assignment?      @relation("GiverAssignment")
  emailLogs             EmailLog[]
  exclusionsAsA         GroupExclusion[] @relation("ExclusionMemberA")
  exclusionsAsB         GroupExclusion[] @relation("ExclusionMemberB")
  secretThreadsTarget   SecretThread[]   @relation("SecretThreadTarget")
  secretThreadsVisitor  SecretThread[]   @relation("SecretThreadVisitor")
  secretMessagesSent    SecretMessage[]  @relation("SecretMessageSender")
  buddyGuessesMade      BuddyGuess[]     @relation("BuddyGuessGuesser")
  buddyGuessesReceived  BuddyGuess[]     @relation("BuddyGuessTarget")

  @@unique([groupId, email])
  @@index([groupId, emailVerifiedAt])
}

model Assignment {
  id                  String   @id @default(cuid())
  groupId             String
  giverMemberId       String   @unique
  receiverHmac        String
  encryptedReceiverId String
  encryptedSecretNote String?
  createdAt           DateTime @default(now())

  group Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  giver Member @relation("GiverAssignment", fields: [giverMemberId], references: [id], onDelete: Cascade)

  @@unique([groupId, giverMemberId])
  @@unique([groupId, receiverHmac])
  @@index([groupId])
}

model EmailLog {
  id        String      @id @default(cuid())
  groupId   String
  memberId  String
  type      EmailType
  status    EmailStatus @default(PENDING)
  attempts  Int         @default(0)
  lastError String?
  sentAt    DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  group  Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([groupId, status])
  @@index([memberId, type])
}

model GroupExclusion {
  id        String   @id @default(cuid())
  groupId   String
  memberAId String
  memberBId String
  createdAt DateTime @default(now())

  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  memberA Member @relation("ExclusionMemberA", fields: [memberAId], references: [id], onDelete: Cascade)
  memberB Member @relation("ExclusionMemberB", fields: [memberBId], references: [id], onDelete: Cascade)

  @@unique([groupId, memberAId, memberBId])
  @@index([groupId])
}

model SecretThread {
  id              String         @id @default(cuid())
  groupId         String
  targetMemberId  String
  visitorMemberId String?
  visitorKey      String
  mode            SecretChatMode @default(PUBLIC_ROOM)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  group         Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  targetMember  Member          @relation("SecretThreadTarget", fields: [targetMemberId], references: [id], onDelete: Cascade)
  visitorMember Member?         @relation("SecretThreadVisitor", fields: [visitorMemberId], references: [id], onDelete: Cascade)
  messages      SecretMessage[]

  @@unique([groupId, targetMemberId, mode, visitorKey])
  @@index([groupId, targetMemberId, updatedAt])
  @@index([groupId, visitorMemberId, updatedAt])
}

model SecretMessage {
  id             String   @id @default(cuid())
  threadId       String
  senderMemberId String
  content        String
  createdAt      DateTime @default(now())

  thread       SecretThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderMember Member       @relation("SecretMessageSender", fields: [senderMemberId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

model BuddyGuess {
  id              String   @id @default(cuid())
  groupId         String
  guesserMemberId String
  guessedGiverId  String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  group        Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  guesser      Member @relation("BuddyGuessGuesser", fields: [guesserMemberId], references: [id], onDelete: Cascade)
  guessedGiver Member @relation("BuddyGuessTarget", fields: [guessedGiverId], references: [id], onDelete: Cascade)

  @@unique([groupId, guesserMemberId])
  @@index([groupId])
}
